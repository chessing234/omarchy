#!/bin/bash

# omarchy:summary=Launch a URL as a web app in the default supported browser
# omarchy:args=<url>

browser=$(omarchy-cmd-default-browser)

case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium.desktop" ;;
esac

# Extra arguments are passed straight to the browser, and Chromium is a
# singleton per profile: if this launch is the one that starts the browser, the
# flags apply to every window in the session — ordinary browsing included — not
# just to this web app. Refuse the flags that would turn a web app launcher into
# a session-wide security downgrade.
# Compare switch names, not spellings. Chromium's POSIX parser accepts one or
# two leading dashes and splits an optional "=value", so --no-sandbox=1 and
# -ignore-certificate-errors carry the same meaning as the canonical forms and
# have to be refused with them.
# Chromium trims surrounding ASCII whitespace before it parses a switch, so
# " --ignore-certificate-errors" as a single argument still reaches it as that
# switch. Trim the same set here before deciding whether an argument is a switch
# and which one it names. Only the comparison uses the trimmed form; the
# argument is forwarded to the browser exactly as it was given.
for arg in "${@:2}"; do
  trimmed=${arg#"${arg%%[![:space:]]*}"}
  trimmed=${trimmed%"${trimmed##*[![:space:]]}"}

  [[ $trimmed == -* ]] || continue

  switch=${trimmed#-}
  switch=${switch#-}
  switch=${switch%%=*}

  case $switch in
  ignore-certificate-errors | disable-web-security | allow-running-insecure-content | \
    remote-debugging-port | remote-debugging-address | remote-debugging-pipe | \
    remote-allow-origins | load-extension | disable-extensions-except | \
    user-data-dir | no-sandbox | disable-site-isolation-trials | disable-gpu-sandbox)
    echo "omarchy-launch-webapp: refusing '$arg' - it would apply to the whole browser session, not just this web app." >&2
    exit 1
    ;;
  esac
done

# Read Exec= from the same data dirs omarchy-cmd-default-browser searched, as
# omarchy-launch-browser does, so a browser it resolved is one this can start.
IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
browser_exec=""
for data_dir in "${data_dirs[@]}"; do
  entry="$data_dir/applications/$browser"
  [[ -f $entry ]] || continue
  browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$entry" | head -1)
  break
done

# Handing an empty command to uwsm-app surfaces as "Command not found: \"\"",
# which fails a keybinding silently. A web app runs in a Chromium-based
# browser, so say that rather than claiming no browser is set.
if [[ -z $browser_exec ]]; then
  echo "omarchy-launch-webapp: web apps need a Chromium-based browser; install Chromium with 'omarchy install browser chromium'" >&2
  omarchy-notification-send -u critical -g 󰖟 "$(omarchy-i18n browser.webappNeedsChromium)" "$(omarchy-i18n browser.webappNeedsChromiumHint)"
  exit 1
fi

if ! omarchy-cmd-browser-handoff "$browser_exec" --app="$1" "${@:2}"; then
  exec setsid uwsm-app -- $browser_exec --app="$1" "${@:2}"
fi
